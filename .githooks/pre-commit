set -eu
# Check exactly the staged source without hiding or rewriting local changes.
if ! git diff --quiet --ignore-submodules -- ||
    [ -n "$(git ls-files --others --exclude-standard)" ]; then
    echo "pre-commit: stage or set aside all non-ignored changes before checking the commit." >&2
    exit 1
fi
exec ./scripts/lint
