# Authoring scaffold: existing SPEC contents are not imported.
[spec]
# Packaging year(s) and SPEC maintainers, not upstream authors.
copyright-years = {{ self::toml_string(year) }}
contributors = [{% if let Some(author) = author %}{{ self::toml_string(author) }}{% endif %}]

[package]
name = {{ self::toml_string(name) }}
version = ""
# Short English summary, without a final period.
summary = ""
# Upstream SPDX expression; confirm from the source licenses.
license = ""
# Project homepage, not the source archive.
url = ""
# Plain text, without SPEC section headers.
description = '''
'''
# requires = ["coreutils"]  # Runtime RPM dependencies, not build tools.
# provides = ["example-capability"]  # Additional RPM capabilities.
# noarch = true  # Only for architecture-independent packages.
{% if full %}# Version characters: letters, digits, . _ + ~ ^. License expressions use AND/OR/WITH.
# These fields describe the main package; subpackages declare their own dependencies.
{% endif %}
[package.vcs]
# Leave unknown facts empty. Choose one only when confirmed:
# git = "https://example.org/owner/project.git"
# same-as-url = true
# no-public-repository = true  # A failed lookup does not confirm absence.

[sources.0]
# Archive URL; %{name}, %{version}, %{url} use the package fields.
url = ""
# Omit sha256 for gen to calculate it; --offline skips downloads. Empty digests fail.
# sha256 = ""  # Supply 64 hexadecimal digits before enabling this line.
# Local materials use path instead of url/sha256; gen does not read or copy them.
# Place local Sources and Patches beside the SPEC: work/WORK/recipe by default.
# Use open WORK to edit the package files.
# [sources.1]
# path = "example.conf"
# Patch declaration order is retained; check the prep action and strip level.
# [patches.0]
# path = "0000-fix-build.patch"
{% if full %}# Missing digests warn if downloads fail; HTTP(S) materials need SHA-256 for submission.
# Add sources.N for other archives. Source and Patch numbers are independent.
# Document each Patch's purpose in its header; generation does not test applicability.
{% endif %}
[build-requires]
# Omit rpm to use profile defaults; an explicit list replaces them, including [].
# Declare the complete list when adding package-specific tools or libraries.
# rpm = ["make", "pkgconfig(zlib) >= 1.3"]

{% if let Some(system) = system %}{% include "buildsystems/buildsystem.toml.j2" %}{% else %}{% include "buildsystems/plain.toml.j2" %}{% endif %}
[package.files]
# Installed paths/native file directives, without %{buildroot}; confirm from build output.
# entries = ["%{_bindir}/%{name}", "%config(noreplace) %{_sysconfdir}/example.conf"]
entries = []
# Source/build-tree files copied as license or documentation:
# license = ["COPYING"]
# doc = ["README"]
# Build-generated file lists; gen does not read them:
# lists = ["%{name}.lang"]
# Subpackage examples: ruyipack new WORK --comments full --stdout, or docs/reference.md (Subpackages).
{% if full %}
# Optional subpackage: the key is a suffix; full-name = true uses it as the complete name.
# Each subpackage needs a summary and description. Omit files for a package with no files.
# [subpackages.devel]
# full-name = false
# summary = "Development files for %{name}"
# description = "Headers and development files for %{name}."
# requires = ["%{name} = %{version}-%{release}"]
# [subpackages.devel.files]
# entries = ["%{_includedir}/%{name}.h"]
{% endif %}