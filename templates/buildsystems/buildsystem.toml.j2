This template renders identically for every build system. The per-stage default
actions and notes come from the selected profile contract under
profiles/openruyi/buildsystems/, which records their openRuyi provenance.
-#}
[build]
system = {{ self::toml_string(system) }}
# Omitted stages use target RPM defaults:
{% for stage in stages %}# {{ stage.name }}: {{ stage.action }}{% if let Some(note) = stage.inline_note %}; {{ note }}{% endif %}.
{% if full %}{% if let Some(note) = stage.full_note %}# {{ note }}
{% endif %}{% endif %}{% endfor %}# options passes arguments; replace supplies the whole script. Do not combine them.
# replace = "" disables a default stage. Scripts omit section headers.
# prepend/append run shell/RPM scripts before/after the main action.
# [build.stages.conf]
# options = []  # Add the project's actual configure options.
# [build.stages.prep]
# options = ["-p1"]  # Set the strip level required by your patches.
{% if full %}# In the chosen stage's table (triple single quotes preserve backslashes):
# prepend = '''
# '''
# append = '''
# '''
# replace = '''
# '''
# Keep %{optflags} and %{build_ldflags} in custom compiler/linker commands.
{% endif %}