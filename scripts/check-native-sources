"""Check the shared Source numbering expectations in a trusted openRuyi RPM environment."""
import argparse
import hashlib
import json
import os
import pathlib
import subprocess
import tempfile

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument("spec", nargs="*", type=pathlib.Path, help="also check these prepared, trusted target SPECs without preprocessing")
parser.add_argument("--require-package", action="append", default=[], help="target macro/build-system package required by this run")
args = parser.parse_args()
os.environ["LC_ALL"] = "C"

def run_checked(command, stage="Native result not accepted"):
    try:
        result = subprocess.run(command, capture_output=True, text=True)
    except OSError as error:
        raise SystemExit(f"{stage}: {error}") from error
    # RPM can report errors on stderr with exit 0; an exit status alone is not evidence.
    if result.returncode or result.stderr.strip():
        raise SystemExit(f"{stage}: {command!r}\nexit={result.returncode}\n{result.stdout}{result.stderr}")
    return result.stdout

root = pathlib.Path(__file__).resolve().parent.parent
packages = run_checked(["rpm", "-q", "rpm", "rpm-build", "rpm-config-openruyi", *args.require_package], "Environment not ready")
print(packages, end="")

cases = root / "tests/fixtures/source-numbering.tsv"
with tempfile.TemporaryDirectory(prefix="ruyipack-native-") as directory:
    print(json.dumps({"rpm": run_checked(["rpm", "--version"]).strip(), "macro_configuration_sha256": hashlib.sha256(run_checked(["rpm", "--showrc"]).encode()).hexdigest(), "preprocessing": "none", "defines": [f"_tmppath {directory}"], "scope": "source-numbering and explicitly supplied SPEC parses"}))
    for case in cases.read_text().splitlines():
        if not case or case.startswith("#"):
            continue
        headers, numbers = case.split("\t")
        headers = headers.split(",")
        numbers = [int(number) for number in numbers.split(",")]
        spec = "%global _smp_mflags -j1\nName: numbering-probe\nVersion: 1\nRelease: 1\nSummary: Source numbering\nLicense: MIT\n"
        for index, header in enumerate(headers):
            spec += f"{header}: https://example.org/asset-{index}.tar.gz\n"
        spec += "\n%description\n"
        for number in range(max(numbers) + 2):
            spec += f"NATIVE_SOURCE{number}=%{{?SOURCE{number}}}\n"
        spec += "\n%files\n"
        path = pathlib.Path(directory) / "numbering.spec"
        path.write_text(spec)
        result = run_checked(["rpmspec", "--define", f"_tmppath {directory}", "-P", str(path)])
        observed = {}
        for line in result.splitlines():
            if line.startswith("NATIVE_SOURCE"):
                field, value = line.split("=", 1)
                if value:
                    observed[int(field.removeprefix("NATIVE_SOURCE"))] = pathlib.PurePosixPath(value).name
        expected = {number: f"asset-{index}.tar.gz" for index, number in enumerate(numbers)}
        if observed != expected:
            raise SystemExit(f"{headers}: expected {expected}, observed {observed}")
        print(f"{','.join(headers)} -> {','.join(map(str, numbers))}: PASS")

    for path in args.spec:
        source = path.read_bytes()
        parsed = run_checked(["rpmspec", "--define", f"_tmppath {directory}", "-P", str(path)])
        facts = run_checked(["rpmspec", "--define", f"_tmppath {directory}", "-q", "--srpm", "--qf", "%{NAME}\t%{VERSION}\t%{RELEASE}\n", str(path)])
        if "%" in facts or not parsed.strip():
            raise SystemExit(f"Native result not accepted: unresolved or missing facts in {path}: {facts!r}")
        print(json.dumps({"spec": str(path), "sha256": hashlib.sha256(source).hexdigest(), "native_identity": facts.strip(), "expanded_sha256": hashlib.sha256(parsed.encode()).hexdigest()}))
