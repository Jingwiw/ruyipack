set -eu
if [ "$#" -ne 1 ]; then
    echo "Usage: $0 /absolute/path/to/ruyipack" >&2
    exit 2
fi
case "$1" in
    /*) binary=$1 ;;
    *) echo "The executable path must be absolute." >&2; exit 2 ;;
esac
root=$(CDPATH= cd "$(dirname "$0")/.." && pwd)
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT HUP INT TERM
cd "$work"
"$binary" init
"$binary" --version
# New uses committed Git content; this smoke test never contacts a remote repository.
export GIT_CONFIG_NOSYSTEM=1 GIT_CONFIG_GLOBAL=/dev/null
export GIT_AUTHOR_NAME='Smoke Fixture' GIT_AUTHOR_EMAIL=fixture@example.org
export GIT_COMMITTER_NAME='Smoke Fixture' GIT_COMMITTER_EMAIL=fixture@example.org
git -c core.hooksPath=/dev/null init --quiet -b main openruyi
mkdir -p openruyi/SPECS/ed
cp "$root/tests/fixtures/ed.spec" openruyi/SPECS/ed/ed.spec
git -C openruyi add .
git -C openruyi -c core.hooksPath=/dev/null -c commit.gpgSign=false commit --quiet -m 'Fixture baseline'
"$binary" open ed --editor true > /dev/null
cp "$root/examples/ed/ed.toml" work/ed/ed.toml
spec=work/ed/recipe/SPECS/ed/ed.spec
cp "$spec" original.spec
"$binary" gen ed --offline
test -s work/ed/ed.resolved.toml
test -s work/ed/stage/ed.candidate.spec
cmp "$spec" original.spec
"$binary" gen ed --offline --output=.
cmp work/ed/ed.spec original.spec
"$binary" gen ed --offline --apply
"$binary" check ed
"$binary" inspect ed > inspect.txt
"$binary" inspect ed --editable --field package.version > version.toml
"$binary" edit ed --set package.version=1.22.6 --diff > version.diff
test -s version.toml
cmp version.diff work/ed/stage/ed.diff
test -s work/ed/stage/ed.candidate.spec
cmp "$spec" original.spec
if "$binary" edit ed --set 'package.version=1 2' --apply; then
    echo "An invalid Version was accepted." >&2
    exit 1
fi
cmp "$spec" original.spec
"$binary" edit ed --set package.version=1.22.6 --apply
cp "$spec" edited.spec
"$binary" open ed-test --pkgname ed --editor true > /dev/null
cmp original.spec work/ed-test/recipe/SPECS/ed/ed.spec
# Identical scaffolds and saved bindings are reused; manual content is protected.
"$binary" new scratch --pkgname scratch > /dev/null
scaffold=work/scratch/scratch.toml
grep -q 'name = "scratch"' "$scaffold"
cp "$scaffold" scratch.original
"$binary" new scratch --pkgname scratch </dev/null
cmp "$scaffold" scratch.original
printf '\n# local note\n' >> "$scaffold"
if "$binary" new scratch --pkgname scratch </dev/null 2>scratch.err; then
    echo "Conflicting scaffold output was accepted without an action." >&2
    exit 1
fi
grep -q "already exists with different content" scratch.err
"$binary" edit ed --field package.version --prepare drafts
printf '\n# Concurrent modification\n' >> "$spec"
cp "$spec" concurrent.spec
if "$binary" edit --from drafts --apply; then
    echo "A stale draft was accepted." >&2
    exit 1
fi
cmp "$spec" concurrent.spec
echo "Installation smoke test passed."
