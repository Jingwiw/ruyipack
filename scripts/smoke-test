set -eu
if [ "$#" -ne 1 ]; then
    echo "Usage: $0 /absolute/path/to/ruyipack" >&2
    exit 2
fi
case "$1" in
    /*) binary=$1 ;;
    *) echo "The executable path must be absolute." >&2; exit 2 ;;
esac
root=$(CDPATH= cd "$(dirname "$0")/.." && pwd)
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT HUP INT TERM
cp "$root/examples/ed/ed.toml" "$work/ed.toml"
cd "$work"
"$binary" --version
"$binary" gen ed
"$binary" check ed.spec
"$binary" inspect ed.spec > inspect.txt
cp ed.spec original.spec
"$binary" edit ed.spec --field package.version --view > version.toml
"$binary" edit ed.spec --set package.version=1.22.6 --diff > version.diff
test -s version.toml && test -s version.diff
cmp ed.spec original.spec
if "$binary" edit ed.spec --set 'package.version=1 2'; then
    echo "An invalid Version was accepted." >&2
    exit 1
fi
cmp ed.spec original.spec
"$binary" edit ed.spec --set package.version=1.22.6
cp ed.spec edited.spec
if "$binary" gen ed </dev/null; then
    echo "Conflicting output was accepted without an action." >&2
    exit 1
fi
cmp ed.spec edited.spec
# init derives NAME.toml and must not offer options it does not have.
mkdir -p SPECS/demo
if "$binary" init demo 2>init.err; then
    echo "A package with an existing SPECS entry was initialized." >&2
    exit 1
fi
grep -q "SPECS/demo already exists" init.err
if grep -q -- "--output" init.err; then
    echo "init advertised an option it does not accept." >&2
    exit 1
fi
if [ -e demo.toml ]; then
    echo "init wrote a manifest for an existing package." >&2
    exit 1
fi
# Identical content is not a conflict; a changed scaffold is.
"$binary" init scratch > /dev/null
grep -q 'name = "scratch"' scratch.toml
cp scratch.toml scratch.original
if ! "$binary" init scratch </dev/null 2>/dev/null; then
    echo "Recreating an identical scaffold failed." >&2
    exit 1
fi
cmp scratch.toml scratch.original
printf '\n# local note\n' >> scratch.toml
if "$binary" init scratch </dev/null 2>scratch.err; then
    echo "Conflicting scaffold output was accepted without an action." >&2
    exit 1
fi
grep -q "already exists with different content" scratch.err
if grep -q -- "--output" scratch.err; then
    echo "init advertised an option it does not accept." >&2
    exit 1
fi
"$binary" edit ed.spec --field package.version --prepare drafts
printf '\n# Concurrent modification\n' >> ed.spec
cp ed.spec concurrent.spec
if "$binary" edit --from drafts; then
    echo "A stale draft was accepted." >&2
    exit 1
fi
cmp ed.spec concurrent.spec
echo "Installation smoke test passed."
